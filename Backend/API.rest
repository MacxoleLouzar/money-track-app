# ─────────────────────────────────────────
# GROCERIES
# ─────────────────────────────────────────

### Add Grocery
POST {{baseUrl}}/expenses/grocery
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "item": "Milk",
  "quantity": 2,
  "price": 35.99,
  "store": "Checkers",
  "onSale": true
}

###

### Get All Groceries
GET {{baseUrl}}/expenses/grocery
Authorization: Bearer {{token}}

###

### Update Grocery
PUT {{baseUrl}}/expenses/grocery/EXPENSE_ID_HERE
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "item": "Milk",
  "quantity": 3,
  "price": 32.99,
  "store": "Pick n Pay",
  "onSale": false
}

###

### Delete Grocery
DELETE {{baseUrl}}/expenses/grocery/EXPENSE_ID_HERE
Authorization: Bearer {{token}}

